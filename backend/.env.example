# Пример переменных окружения MD-Next.
# Скопируйте в backend/.env и заполните под своё окружение.
# В разработке backend не читает .env сам — экспортируйте переменные
# в окружении терминала. На сервере файл подхватывает systemd
# через EnvironmentFile=/opt/md-next/backend/.env.

# --- Обязательное ---

# Секрет для подписи JWT. Без него backend не запустит выдачу токенов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Публичный адрес панели. Используется в ссылках подписок.
PANEL_PUBLIC_URL=https://panel.example.com

# Пароль первого администратора (логин admin).
# Используется только при первом запуске на пустой базе.
INITIAL_ADMIN_PASSWORD=

# --- Сервер и TLS ---

SERVER_HOST=example.com
SERVER_PUBLIC_IP=

TLS_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem

# --- Xray ---

XRAY_PRIVATE_KEY=
XRAY_PUBLIC_KEY=
XRAY_SERVER_NAME=example.com
XRAY_DEST=127.0.0.1:8080
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
XRAY_XHTTP_REALITY_PORT=2053
# Секретный путь XHTTP-TLS; генерируется установщиком при первом запуске.
XRAY_XHTTP_TLS_PATH=
# Путь к файлу с geo-ссылками (geosite.dat / geoip.dat), если он есть.
XRAY_LOCATION_ASSET=

# URL проверки выхода в интернет. Должен отдавать 2xx/3xx/4xx и не требовать авторизации.
XRAY_PROBE_URL=https://cp.cloudflare.com/generate_204
# Устаревший параметр: переключением теперь управляет только watchdog.
# Интервал настоящих проверок задаётся FAILOVER_INTERVAL_S ниже.
XRAY_PROBE_INTERVAL=3m

# --- Диагностика нод (необязательно) ---

# true: watchdog проверяет реальный выход в интернет через каждую ноду, а не только
# открытость порта. Нода без доступа в сеть будет помечена недоступной.
NODE_PROBE_ENABLED=false
# Базовый порт для диагностических SOCKS-инбундов: порт ноды = база + id ноды.
NODE_PROBE_BASE_PORT=10900
NODE_PROBE_TIMEOUT=8

# --- AmneziaWG ---

AWG_CONFIG_PATH=/etc/amnezia/amneziawg/awg0.conf
AWG_SUBNET=10.8.0.0/24
AWG_PORT=51820

# --- Nginx ---

NGINX_PANEL_CONFIG=/etc/nginx/sites-available/md-next.conf
# Таблица SNI: при изменении Reality SNI новая запись добавляется после nginx -t.
NGINX_STREAM_CONFIG=/etc/nginx/stream-available/md-next-stream.conf

# --- Сеть ---

# Интерфейс для probe и failover. Пустое значение — определить автоматически.
NET_INTERFACE=

# --- Telegram-бот (необязательно) ---

TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
TELEGRAM_PROXY_URL=

# --- Миграции (необязательно) ---

# Переопределяет URL из alembic.ini.
ALEMBIC_URL=

# --- Cluster failover (необязательно, есть значения по умолчанию) ---

FAILOVER_INTERVAL_S=15
FAILOVER_FAILURE_COUNT=3
FAILOVER_FAILBACK_STABLE_CHECKS=3
FAILOVER_COOLDOWN_S=30

# Устаревшие названия, поддерживаются для совместимости:
# WATCHDOG_INTERVAL, WATCHDOG_FAILURE_THRESHOLD,
# WATCHDOG_RECOVERY_THRESHOLD, WATCHDOG_RECOVERY_COOLDOWN
